# --- Correo (IMAP) donde llegan los avisos del banco ---
IMAP_HOST=imap.gmail.com
IMAP_USER=tucorreo@gmail.com
IMAP_PASSWORD=contraseña-de-aplicacion
IMAP_FOLDER=INBOX
POLL_SECONDS=30
# Solo procesar correos cuyo remitente contenga alguno de estos textos (separados por coma). Vacío = todos.
ALLOWED_SENDERS=bac,bncr,bancobcr,promerica,notificaciones
# Si es 0 solo se procesan correos nuevos desde que arranca la app. Si es N, también los de los últimos N días.
INITIAL_DAYS=0

# --- Acceso a la web (usuario: admin) ---
APP_PASSWORD=cambia-esto

# --- Notificaciones (activa una o varias) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Para ver el estado/alertas si el correo deja de llegar (horas sin ningún correo bancario). 0 = desactivado
SILENCE_ALERT_HOURS=0

DB_PATH=data.db
